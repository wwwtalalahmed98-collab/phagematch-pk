# text is not, and the cover letter is correspondence rather than research
# output. Add the manuscript here after acceptance.
docs/manuscript_draft.md
docs/manuscript_submission.md
docs/manuscript_submission.docx
docs/manuscript_final.md
docs/manuscript_final.docx
docs/results_draft.md
docs/cover_letter.md

